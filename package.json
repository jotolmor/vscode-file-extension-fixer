{
  "name": "auto-extension-files",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.2",
  "publisher": "jorgetoledomoreno",
  "license": "MIT",
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/jotolmor/vscode-file-extension-fixer.git"
  },
  "bugs": {
    "url": "https://github.com/jotolmor/vscode-file-extension-fixer/issues"
  },
  "homepage": "https://github.com/jotolmor/vscode-file-extension-fixer#readme",
  "galleryBanner": {
    "color": "#F3F2F2",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "extension",
    "rename",
    "filename",
    "language",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension renames files in the workspace, so it requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Renaming needs a real filesystem, so virtual workspaces are not supported."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "fileExtensionFixer.fixFileExtension",
        "title": "%command.fixFileExtension%",
        "category": "File Extension Fixer"
      },
      {
        "command": "fileExtensionFixer.setFolderLanguage",
        "title": "%command.setFolderLanguage%",
        "category": "File Extension Fixer"
      }
    ],
    "configuration": {
      "title": "File Extension Fixer",
      "properties": {
        "fileExtensionFixer.folderLanguages": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.folderLanguages%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/file-names.test.js && node test/project-language.test.js && node test/folder-language.test.js && node test/open-path.test.js && node test/create-path.test.js"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
